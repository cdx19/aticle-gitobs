{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "obsidian": [
        "node_modules/obsidian"
      ]
    },
    "module": "ESNext",
    "target": "ES2018",
    "moduleResolution": "bundler",
    "allowJs": false,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts"
  ]
}